# Copy to .env for local runs. Do not commit .env.

# Azure subscription and resource names
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_LOCATION=
AZURE_RESOURCE_GROUP=

# Azure AI Search
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_INDEX_NAME=semantic-query-gxp

# Azure OpenAI / Foundry model deployments
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
AZURE_OPENAI_GENERATION_DEPLOYMENT=

# Experiment controls
SEMQRY_EXPERIMENT_CONFIG=infra/config/experiment.json
SEMQRY_RANDOM_SEED=20260507
