{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/semantic-query-experiment/relevance-label.schema.json",
  "title": "RelevanceLabel",
  "type": "object",
  "required": [
    "schema_version",
    "query_id",
    "document_id",
    "relevance",
    "label_source",
    "rationale"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "query_id": { "type": "string" },
    "document_id": { "type": "string" },
    "relevance": { "type": "integer", "minimum": 0, "maximum": 3 },
    "label_source": { "const": "generator_fact_coverage" },
    "rationale": { "type": "string" }
  },
  "additionalProperties": false
}
